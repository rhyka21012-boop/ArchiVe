rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー名前空間下のすべて：本人のみR/W可
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                        && request.auth.uid == userId;
    }

    // 公開リスト共有：誰でも読める、作成は所有者のみ
    match /shared_lists/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.ownerUid == request.auth.uid;
    }

    // ユーザー行動記録：本人のみ R/W
    // (集計は Cloud Function `getActivityStats` から admin SDK 経由で読む)
    match /user_activity/{userId} {
      allow read, write: if request.auth != null
                        && request.auth.uid == userId;
    }

    // AI タグ提案の 1日1回制限：Cloud Function からのみ書き込みを行うため
    // クライアントからは一切アクセスさせない
    match /ai_usage/{userId} {
      allow read, write: if false;
    }
  }
}
